SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@invertedcrayon.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
IMGBB_API_KEY="0d86fffbb9edac667776d64a994175df"

# Everything below is optional — each feature falls back to a safe mock when unset.
# See the "Going live: third-party integrations" section of README.md for details.

# SITE_URL="https://yourstore.com"

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""
# BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_SANDBOX="true"

# Email — pick ONE of the two. SMTP sends from your own mailbox (Gmail, or any domain mailbox);
# Resend is an API service that needs a verified sending domain (it can't send from @gmail.com).
# If both are set, SMTP is used. See README -> "Email setup".
#
# SMTP (e.g. Gmail: smtp.gmail.com / 465, the Gmail address, and a 16-character APP password):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="invertedcrayonofficial@gmail.com"
# SMTP_PASS=""
# EMAIL_FROM="Inverted Crayon <invertedcrayonofficial@gmail.com>"   # optional with SMTP
#
# Resend:
# RESEND_API_KEY=""
# EMAIL_FROM="Inverted Crayon <hello@yourstore.com>"

# Real SMS (SSL Wireless SMS Plus) — see "SMS setup" in the README. Both are needed; without them
# texts are only recorded in /admin/sms.
# SSLWIRELESS_SMS_API_TOKEN=""
# SSLWIRELESS_SMS_SID=""                      # your approved Sender ID
# SSLWIRELESS_SMS_BASE_URL="https://smsplus.sslwireless.com/api/v3"   # optional
