// Inverted Crayon — data model
// Faithful to Build Spec §10 (Product, Variant, Category, Collection, Tag,
// Order, OrderItem, Customer, Discount, Campaign, Review), extended with the
// practical entities needed to actually run the store (admin users,
// addresses, wishlist, back-in-stock subscriptions, CMS content blocks).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

enum TagType {
  PREORDER
  NEW
  LIMITED
  BESTSELLER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentMethod {
  BKASH
  NAGAD
  SSLCOMMERZ
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
  INTERNATIONAL
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  ADMIN
  STAFF
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

// ---------- catalog ----------

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String
  gender         Gender
  basePrice      Decimal       @db.Decimal(10, 2)
  status         ProductStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants     Variant[]
  images       ProductImage[]
  collections  ProductCollection[]
  tags         ProductTag[]
  reviews      Review[]
  orderItems   OrderItem[]
  wishlistedBy WishlistItem[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([gender, categoryId])
  @@index([status])
}

model Variant {
  id                String  @id @default(cuid())
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String  @unique
  size              String
  color             String
  colorHex          String?
  priceOverride     Decimal? @db.Decimal(10, 2)
  stockQty          Int     @default(0)
  lowStockThreshold Int     @default(5)

  orderItems      OrderItem[]
  backInStockSubs BackInStockSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  position    Int     @default(0)
  accentColor String?
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  position Int       @default(0)
  products Product[]
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  heroCopy    String?
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  products    ProductCollection[]
  createdAt   DateTime @default(now())
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

// Cosmetic/behavioral tags. Sale and Sold-out are intentionally NOT rows here
// — Sale is derived from an active Campaign, Sold-out is derived from stock.
model Tag {
  id       String       @id @default(cuid())
  type     TagType      @unique
  label    String
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  meta      Json? // e.g. { "shipDate": "2026-10-15" } for preorder
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// ---------- customers ----------

model Customer {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String?
  phone            String?
  notes            String?
  segmentTags      String[]  @default([])
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  addresses       Address[]
  orders          Order[]
  wishlist        WishlistItem[]
  backInStockSubs BackInStockSubscription[]
  reviews         Review[]
  returns         ReturnRequest[]

  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  area       String
  district   String
  postcode   String
  country    String   @default("Bangladesh")
  isDefault  Boolean  @default(false)
}

// ---------- orders ----------

model Order {
  id     String @id @default(cuid())
  number String @unique
  email  String
  phone  String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  shippingCost   Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  shippingZone     ShippingZone
  shippingFullName String
  shippingPhone    String
  shippingLine1    String
  shippingArea     String
  shippingDistrict String
  shippingPostcode String
  shippingCountry  String       @default("Bangladesh")

  isPreorder       Boolean  @default(false)
  preorderShipMode String? // "together" | "split"
  discountCode     String?

  trackingCourier String?
  trackingRef     String?
  internalNotes   String?

  items   OrderItem[]
  returns ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  productTitleSnapshot String
  variantLabelSnapshot String
  qty                  Int
  unitPrice            Decimal @db.Decimal(10, 2)
  lineTotal            Decimal @db.Decimal(10, 2)
  isPreorder           Boolean @default(false)

  returnItems ReturnItem[]
}

model ReturnRequest {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  reason     String
  status     ReturnStatus @default(REQUESTED)
  items      ReturnItem[]
  createdAt  DateTime     @default(now())
}

model ReturnItem {
  id           String        @id @default(cuid())
  returnId     String
  returnReq    ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id])
  qty          Int
}

// ---------- marketing ----------

model Discount {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @default(0) @db.Decimal(10, 2)
  minSpend       Decimal?     @db.Decimal(10, 2)
  categoryId     String?
  firstOrderOnly Boolean      @default(false)
  usageLimit     Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model Campaign {
  id               String    @id @default(cuid())
  name             String
  percentOff       Decimal?  @db.Decimal(5, 2)
  fixedSalePrice   Decimal?  @db.Decimal(10, 2)
  targetCategoryId String?
  targetProductIds String[]  @default([])
  startsAt         DateTime
  endsAt           DateTime
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  authorName String
  rating     Int
  body       String
  status     ReviewStatus @default(PENDING)
  reply      String?
  createdAt  DateTime     @default(now())

  @@unique([productId, customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model BackInStockSubscription {
  id         String    @id @default(cuid())
  email      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([email, variantId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------- admin / CMS ----------

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             AdminRole @default(STAFF)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
}

// Freeform CMS blocks keyed by slot (home_hero, home_featured_drop, men_hero, ...)
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

// Store-wide settings: shipping zone rates, payment gateway toggles, COD rules, tax, etc.
model StoreSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// ---------- journal / blog ----------

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  body        String
  accentColor String      @default("#ff2d84")
  authorName  String      @default("Inverted Crayon")
  status      PostStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ---------- email (mocked outbox) ----------

enum EmailType {
  WELCOME
  ORDER_CONFIRMED
  ORDER_SHIPPED
  BACK_IN_STOCK
  PREORDER_SHIP_UPDATE
  ABANDONED_CHECKOUT
  CONTACT_RECEIVED
}

model EmailLog {
  id            String    @id @default(cuid())
  to            String
  subject       String
  body          String
  type          EmailType
  relatedOrderId String?
  sentAt        DateTime  @default(now())

  @@index([to])
  @@index([type])
}

// Captured at checkout (on contact-step blur) so an abandoned session can be
// followed up on. Cleared once that email completes an order.
model AbandonedCheckout {
  id           String    @id @default(cuid())
  email        String    @unique
  cartSnapshot Json
  remindedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
