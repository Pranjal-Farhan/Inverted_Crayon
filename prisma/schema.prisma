// Inverted Crayon — data model
// Faithful to Build Spec §10 (Product, Variant, Category, Collection, Tag,
// Order, OrderItem, Customer, Discount), extended with the
// practical entities needed to actually run the store (admin users,
// addresses, wishlist, back-in-stock subscriptions, CMS content blocks).
// No customer-facing review system — admin-only product notes instead (ManufacturerLink).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

enum TagType {
  PREORDER
  NEW
  LIMITED
  BESTSELLER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentMethod {
  BKASH
  SSLCOMMERZ
  COD
}

enum FreeDeliveryScope {
  NONE
  INSIDE_DHAKA
  NATIONWIDE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

// Whether a coupon works on every product (GLOBAL) or only on products the admin explicitly
// attaches it to in the product editor (PRODUCT) — see Discount.products.
enum CouponScope {
  GLOBAL
  PRODUCT
}

// Separate from the coupon-code DiscountType above (which also has FIXED/FREE_SHIPPING, meant
// for the cart-level Discount model) — this one is just the two shapes a per-product markdown
// can take: a straight percent off, or a flat amount off.
enum ProductDiscountType {
  PERCENT
  AMOUNT
}

enum AdminRole {
  ADMIN
  STAFF
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

// ---------- catalog ----------

model Product {
  id                         String               @id @default(cuid())
  slug                       String               @unique
  title                      String
  description                String
  gender                     Gender
  basePrice                  Decimal              @db.Decimal(10, 2)
  // A standing markdown set directly on the product (no start/end date — on until an admin
  // removes it). Null discountType means no discount is active; deriveProductDisplay
  // (src/lib/product-view.ts) prices the product from it.
  discountType               ProductDiscountType?
  discountValue              Decimal?             @db.Decimal(10, 2)
  status                     ProductStatus        @default(DRAFT)
  seoTitle                   String?
  seoDescription             String?
  freeDelivery               FreeDeliveryScope    @default(NONE)
  // Per-product delivery-charge override — null means "use the store's default shipping rate for
  // this zone" (store-settings.ts). Delivery cost varies order to order by what's actually being
  // shipped, so the admin can set each product's own charge instead of one flat site-wide fee.
  // When a cart mixes several such products, the highest of their overrides applies — see
  // resolveShippingCost() in src/lib/shipping.ts, the one place both checkout.ts (authoritative)
  // and CheckoutView.tsx (display) compute this from, so the number shown always matches the charge.
  deliveryChargeInsideDhaka  Decimal?             @db.Decimal(10, 2)
  deliveryChargeOutsideDhaka Decimal?             @db.Decimal(10, 2)
  // { columns: string[]; rows: { size: string; values: string[] }[] } — see src/lib/size-guide.ts.
  // Null = this product has no measurements entered yet; the PDP falls back to a generic chart.
  sizeGuide                  Json?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants          Variant[]
  images            ProductImage[]
  tags              ProductTag[]
  orderItems        OrderItem[]
  wishlistedBy      WishlistItem[]
  stockPurchases    StockPurchase[]
  manufacturerLinks ManufacturerLink[]
  // Product-locked coupons attached to this product (Discount.scope = PRODUCT). Global coupons
  // never appear here — they apply everywhere without being attached.
  coupons           Discount[]         @relation("CouponProducts")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([gender, categoryId])
  @@index([status])
}

model Variant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  size              String
  color             String
  colorHex          String?
  priceOverride     Decimal? @db.Decimal(10, 2)
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(5)

  // Admin-set per-unit advance (set per size/color at product insertion). Null = this variant
  // isn't preorder-eligible — once it hits 0 stock it's just sold out, same as before this
  // existed. Any set value (0 or more) makes it preorder-eligible the moment stockQty hits 0:
  // 0 means "reserve now, everything due on delivery"; a positive amount is charged online at
  // checkout, with the rest collected as COD. This is the single source of truth for whether an
  // out-of-stock variant can still be bought — see product-view.ts's variantPreorderEligible().
  preorderAdvanceAmount Decimal? @db.Decimal(10, 2)

  orderItems      OrderItem[]
  backInStockSubs BackInStockSubscription[]
  stockPurchases  StockPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  position    Int     @default(0)
  accentColor String?

  @@index([productId, position])
}

// A category always belongs to exactly one main branch (gender). Men/Women/Unisex each
// have their own independent subcategory set — the same name ("Jeans") can exist once per
// branch, as three distinct rows. A Unisex subcategory is mirrored into Men and Women (same
// name/slug, auto-created if missing — see ensureMirrorCategories in admin-categories.ts) so
// it's browsable from every relevant branch; products stay on their own single categoryId
// and are picked up under the mirrored branches at query time by matching gender + slug
// (see getPLPResults in src/lib/plp.ts), not by duplicating rows.
model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String
  gender   Gender
  position Int       @default(0)
  imageUrl String?
  products Product[]

  @@unique([gender, slug])
}

// Cosmetic/behavioral tags. Sale and Sold-out are intentionally NOT rows here
// — Sale is derived from the product's own discount, Sold-out is derived from stock.
model Tag {
  id       String       @id @default(cuid())
  type     TagType      @unique
  label    String
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  meta      Json? // e.g. { "shipDate": "2026-10-15" } for preorder
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// ---------- customers ----------

model Customer {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String?
  phone            String?
  // Google's OAuth userinfo response already includes this (scope "profile"); set at sign-in for
  // Google accounts, left null otherwise — the UI falls back to an initial-letter avatar then.
  avatarUrl        String?
  notes            String?
  segmentTags      String[]  @default([])
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  googleId         String?   @unique
  facebookId       String?   @unique

  addresses       Address[]
  orders          Order[]
  wishlist        WishlistItem[]
  backInStockSubs BackInStockSubscription[]
  returns         ReturnRequest[]

  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  area       String
  district   String
  postcode   String
  country    String   @default("Bangladesh")
  isDefault  Boolean  @default(false)
}

// ---------- orders ----------

model Order {
  id     String @id @default(cuid())
  number String @unique
  email  String
  phone  String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  shippingCost   Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)

  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(PENDING)
  paymentTransactionId String? // gateway reference (bKash paymentID / SSLCommerz val_id) for reconciliation

  // Preorder partial payment: advancePercent/advanceAmount is what was actually captured online
  // (min 20%, up to 100%); any shortfall is collected as cash on delivery (balanceDue).
  advancePercent   Int?
  advanceAmount    Decimal @default(0) @db.Decimal(10, 2)
  balanceDue       Decimal @default(0) @db.Decimal(10, 2)
  balanceCollected Boolean @default(false)

  shippingZone     ShippingZone
  shippingFullName String
  shippingPhone    String
  shippingLine1    String
  shippingArea     String
  shippingDistrict String
  shippingPostcode String
  shippingCountry  String       @default("Bangladesh")

  isPreorder       Boolean @default(false)
  preorderShipMode String? // "together" | "split"
  discountCode     String?

  trackingCourier String?
  trackingRef     String?
  internalNotes   String?

  // Set when the customer asks (from their account's order page) to cancel an order that hasn't
  // shipped yet. Only a flag + their reason for the admin to act on — the admin still decides and
  // performs the actual cancellation/refund.
  cancellationRequestedAt DateTime?
  cancellationReason      String?

  items            OrderItem[]
  returns          ReturnRequest[]
  couponRedemption DiscountRedemption?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  productTitleSnapshot  String
  variantLabelSnapshot  String
  qty                   Int
  unitPrice             Decimal  @db.Decimal(10, 2)
  lineTotal             Decimal  @db.Decimal(10, 2)
  isPreorder            Boolean  @default(false)
  // Per-unit advance at the moment this order was placed — a snapshot, same reasoning as
  // productTitleSnapshot: the variant's own preorderAdvanceAmount can change later (or the
  // variant can be deleted) without rewriting history. Null for non-preorder items.
  preorderAdvanceAmount Decimal? @db.Decimal(10, 2)

  returnItems ReturnItem[]
}

model ReturnRequest {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  reason     String
  status     ReturnStatus @default(REQUESTED)
  items      ReturnItem[]
  createdAt  DateTime     @default(now())
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  returnReq   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  qty         Int
}

// ---------- marketing ----------

// A coupon code. type: PERCENT (value is a %), FIXED (value is a flat ৳ amount) or FREE_SHIPPING
// (value unused). usageLimit is the global redemption budget across all customers — one customer
// may redeem the same code repeatedly, only this shared counter ever runs out (usedCount, bumped
// atomically at checkout with a guarded update, see redeemCoupon in src/lib/coupon.ts). startsAt/
// endsAt both null = no time limit. One coupon per order, enforced by DiscountRedemption.orderId
// being unique.
model Discount {
  id                String               @id @default(cuid())
  code              String               @unique
  type              DiscountType
  value             Decimal              @default(0) @db.Decimal(10, 2)
  // Ceiling on what a PERCENT coupon can take off one order ("10% off, up to ৳500"). Null =
  // uncapped. Meaningless for FIXED (the amount itself is the ceiling) and FREE_SHIPPING.
  maxDiscountAmount Decimal?             @db.Decimal(10, 2)
  minSpend          Decimal?             @db.Decimal(10, 2)
  categoryId        String?
  firstOrderOnly    Boolean              @default(false)
  usageLimit        Int?
  usedCount         Int                  @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  active            Boolean              @default(true)
  scope             CouponScope          @default(GLOBAL)
  // Only consulted when scope is PRODUCT: the products this coupon is valid on. Managed from each
  // product's editor ("Coupons" panel), not from the coupon form.
  products          Product[]            @relation("CouponProducts")
  redemptions       DiscountRedemption[]
  createdAt         DateTime             @default(now())
}

// One row per order that used a coupon — the usage ledger the Discounts admin page reads (who,
// which order, how much it saved). `amount` is the value of the benefit: the item discount for
// PERCENT/FIXED, or the delivery charge waived for FREE_SHIPPING (Order.discountAmount stays 0
// for those, since the waived shipping is just a shippingCost of 0). orderId is unique — a coupon
// per order, never two.
model DiscountRedemption {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id])
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([discountId, createdAt])
}

// Admin-only notes on a product, almost always a link to its manufacturer's page — never shown
// to customers. One row per link; the admin adds/removes them freely and can tag exactly one as
// the "current vendor" (isCurrentVendor) — see src/actions/admin-manufacturer-links.ts, which
// enforces that exclusivity (unsetting any other row's flag in the same transaction) rather than
// a DB constraint, since this is low-stakes/admin-only and a transaction is simpler than a
// partial unique index.
model ManufacturerLink {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url             String
  position        Int      @default(0)
  isCurrentVendor Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([productId, position])
}

model WishlistItem {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([customerId, productId])
}

model BackInStockSubscription {
  id         String    @id @default(cuid())
  email      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([email, variantId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------- inventory finance ----------
// Who actually paid for a batch of stock, and what it cost — separate from Variant.stockQty
// (the live count) and from Order/OrderItem (the sell side). Recording a purchase here also
// increments the variant's stockQty, so this becomes the accountable way stock goes up.

model StockOwner {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  notes     String?
  createdAt DateTime @default(now())

  purchases StockPurchase[]
}

model StockPurchase {
  id      String     @id @default(cuid())
  ownerId String
  owner   StockOwner @relation(fields: [ownerId], references: [id])

  // Nullable + snapshotted so a purchase record survives the product/variant later being deleted
  // — same pattern as OrderItem on the sell side.
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId            String?
  variant              Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitleSnapshot String
  variantLabelSnapshot String

  quantity     Int
  unitCost     Decimal  @db.Decimal(10, 2)
  totalCost    Decimal  @db.Decimal(10, 2)
  supplierName String?
  purchaseDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([variantId])
}

// ---------- admin / CMS ----------

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  // Nullable: an admin/staff account can be OAuth-only (Google/Facebook). OAuth sign-in for admin
  // accounts only ever signs in to an account that already exists (matched by email) — it never
  // self-registers a new admin, so this being nullable doesn't open a privilege-escalation path.
  passwordHash     String?
  name             String
  role             AdminRole @default(STAFF)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  googleId         String?   @unique
  facebookId       String?   @unique

  // TOTP two-factor auth (RFC 6238, e.g. Google Authenticator). twoFactorSecret is only meaningful
  // once twoFactorEnabled is true — a secret can exist mid-setup (QR shown, not yet confirmed)
  // without turning enforcement on. Backup codes are stored bcrypt-hashed, each single-use.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  createdAt DateTime @default(now())
}

// Freeform CMS blocks keyed by slot (home_hero, home_featured_drop, men_hero, ...)
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

// Store-wide settings: shipping zone rates, payment gateway toggles, COD rules, tax, etc.
model StoreSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// Reusable size-guide tables an admin builds once (e.g. "Men's Tees", "Snapbacks — One Size")
// and imports directly into any product's own Size guide panel, instead of retyping the same
// columns/rows for every product that shares a fit. `data` is { columns: string[]; rows:
// { size: string; values: string[] }[] } — same shape as Product.sizeGuide (src/lib/size-guide.ts).
model SizeGuideTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- email (mocked outbox) ----------

enum EmailType {
  // Sent to customers
  WELCOME
  ORDER_CONFIRMED
  ORDER_SHIPPED
  BACK_IN_STOCK
  PREORDER_SHIP_UPDATE
  CONTACT_RECEIVED
  // Retired: abandoned-bag reminders no longer exist. The value stays only because Postgres can't
  // drop an enum value without rewriting the type, and old outbox rows still carry it.
  ABANDONED_CHECKOUT
  // Sent to the brand's official address (Settings -> Store -> email) — see src/lib/message-templates.ts
  ADMIN_CONTACT_MESSAGE
  ADMIN_NEW_ORDER
  ADMIN_NEW_PREORDER
  ADMIN_ORDER_UPDATE
  ADMIN_CANCELLATION_REQUEST
  ADMIN_ACCOUNT_REGISTERED
  ADMIN_LOGIN_LOCKOUT
  ADMIN_ORDER_DELIVERED
  ADMIN_RETURN_REQUEST
  ADMIN_NOTIFY_ME
}

// What became of an email once the outbox row was written: LOGGED = recorded only (no provider is
// connected), SENT = handed to the provider, FAILED = the provider refused it (see deliveryError).
enum EmailDelivery {
  LOGGED
  SENT
  FAILED
}

model EmailLog {
  id             String        @id @default(cuid())
  to             String
  subject        String
  body           String
  type           EmailType
  relatedOrderId String?
  sentAt         DateTime      @default(now())
  delivery       EmailDelivery @default(LOGGED)
  deliveryError  String?

  @@index([to])
  @@index([type])
}

// ---------- sms (mocked outbox) ----------
// Same "always log, optionally really send" pattern as EmailLog. relatedOrderId is a plain string
// (the human-facing order number), not a real FK — same reasoning as EmailLog: the log should
// survive an order later being deleted.

enum SmsType {
  ORDER_CONFIRMED_PAID
  ORDER_CONFIRMED_COD
  // The preorder confirmation ("pre-order requested") — the name predates preorders dropping the
  // advance/balance split, so it's kept to avoid rewriting every existing SmsLog row.
  ORDER_CONFIRMED_PARTIAL
  ACCOUNT_REGISTERED
  ORDER_SHIPPED
}

model SmsLog {
  id             String   @id @default(cuid())
  to             String
  body           String
  type           SmsType
  relatedOrderId String?
  sentAt         DateTime @default(now())

  @@index([to])
  @@index([type])
}
